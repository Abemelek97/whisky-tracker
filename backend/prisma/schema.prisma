generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Room {
  id          String     @id @default(uuid())
  name        String     // e.g. "Dubai Terminal 3 ➔ Bole Vault"
  code        String     @unique // e.g. "DXB-ADD-77"
  pin         String     // Secret PIN to join
  createdAt   DateTime   @default(now())
  users       User[]
  shipments   Shipment[]
}

model User {
  id        String     @id @default(uuid())
  name      String
  phone     String     @unique
  password  String
  role      String     // 'sender', 'receiver', 'superadmin'
  roomId    String?
  room      Room?      @relation(fields: [roomId], references: [id])
  createdAt DateTime   @default(now())
  shipments Shipment[] @relation("UserShipments")
}

model Shipment {
  id               String    @id
  brand            String
  quantity         Int
  sender           String
  senderCity       String    @default("Dubai, UAE")
  receiver         String
  receiverCity     String    @default("Addis Ababa, ET")
  travelerName     String
  travelerPhone    String
  departureDate    String
  status           String    @default("Dispatched")
  receivedQuantity Int?
  notes            String?
  lastCalledAt     String?
  createdAt        DateTime  @default(now())
  createdById      String?
  createdBy        User?     @relation("UserShipments", fields: [createdById], references: [id])
  roomId           String?
  room             Room?     @relation(fields: [roomId], references: [id])
}